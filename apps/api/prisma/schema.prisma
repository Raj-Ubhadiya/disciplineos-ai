generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  phone           String?   @unique
  password        String?
  googleId        String?   @unique
  name            String?
  role            String    @default("member")
  authProvider    String    @default("password")
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  profile                UserProfile?
  goals                  Goal[]
  habits                 Habit[]
  habitCompletions       HabitCompletion[]
  focusSessions          FocusSession[]
  distractionLogs        DistractionLog[]
  aiPlans                AiPlan[]
  reminders              Reminder[]
  dailyReflections       DailyReflection[]
  relationships          Relationship[]        @relation("RelationshipOwner")
  partnerRelationships   Relationship[]        @relation("RelationshipPartner")
  relationshipCheckIns   RelationshipCheckIn[]
  authOtps               AuthOtp[]
}

model AuthOtp {
  id         String    @id @default(cuid())
  userId     String?
  channel    String
  target     String
  email      String?
  phone      String?
  codeHash   String
  purpose    String
  name       String?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([channel, target, purpose, createdAt])
  @@index([expiresAt])
}

model UserProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  mainDream             String?
  currentLifeFocus      String?
  biggestDistractions   String[]
  dailyFocusMinutes     Int      @default(60)
  preferredReminderTone String   @default("supportive")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Goal {
  id             String    @id @default(cuid())
  userId         String
  relationshipId String?
  title          String
  description    String?
  category       String
  priority       Int       @default(3)
  whyItMatters   String?
  status         String    @default("active")
  targetDate     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  relationship  Relationship? @relation(fields: [relationshipId], references: [id], onDelete: SetNull)
  habits        Habit[]
  focusSessions FocusSession[]

  @@index([userId])
  @@index([relationshipId])
}

model Habit {
  id            String   @id @default(cuid())
  userId        String
  goalId        String?
  title         String
  frequency     String   @default("daily")
  reminderTime  String?
  currentStreak Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal          Goal?             @relation(fields: [goalId], references: [id], onDelete: SetNull)
  completions   HabitCompletion[]
  focusSessions FocusSession[]

  @@index([userId])
  @@index([goalId])
}

model HabitCompletion {
  id          String   @id @default(cuid())
  userId      String
  habitId     String
  completedAt DateTime @default(now())
  note        String?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([habitId])
}

model FocusSession {
  id              String   @id @default(cuid())
  userId          String
  goalId          String?
  habitId         String?
  title           String
  durationMinutes Int
  energyLevel     String?
  distractionFree Boolean  @default(false)
  note            String?
  startedAt       DateTime @default(now())
  createdAt       DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal  Goal?  @relation(fields: [goalId], references: [id], onDelete: SetNull)
  habit Habit? @relation(fields: [habitId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([goalId])
  @@index([habitId])
  @@index([startedAt])
}

model DistractionLog {
  id                String   @id @default(cuid())
  userId            String
  platform          String
  minutesLost       Int
  triggerReason     String?
  moodBefore        String?
  moodAfter         String?
  replacementAction String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AiPlan {
  id                  String   @id @default(cuid())
  userId              String
  dream               String
  currentSituation    String?
  mainObstacle        String?
  suggestedGoals      Json
  suggestedHabits     Json
  distractionStrategy Json
  weeklyPlan          Json
  mentorStory         String
  createdAt           DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Reminder {
  id          String    @id @default(cuid())
  userId      String
  title       String
  type        String
  scheduledAt DateTime
  note        String?
  status      String    @default("pending")
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([scheduledAt])
  @@index([status])
}

model DailyReflection {
  id                 String   @id @default(cuid())
  userId             String
  mood               String
  wins               String?
  blockers           String?
  distractions       String?
  tomorrowCommitment String?
  focusScore         Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model Relationship {
  id          String   @id @default(cuid())
  ownerId     String
  partnerId   String?
  partnerName String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner   User   @relation("RelationshipOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  partner User?  @relation("RelationshipPartner", fields: [partnerId], references: [id], onDelete: SetNull)
  checkIns RelationshipCheckIn[]
  goals    Goal[]

  @@index([ownerId])
  @@index([partnerId])
}

model RelationshipCheckIn {
  id             String   @id @default(cuid())
  relationshipId String
  userId         String
  mood           String
  appreciation   String?
  concern        String?
  commitment     String?
  createdAt      DateTime @default(now())

  relationship Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([relationshipId])
  @@index([userId])
}
